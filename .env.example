# ===================================================================
# ملف إعدادات البيئة لمنصة طرقع لاختبارات قدرات كمي
# Tarqa Platform Environment Variables
# ===================================================================

# 1. إعدادات قاعدة بيانات ومصادقة Supabase (اختياري، المنصة تدعم وضع المعاينة الفوري محلياً)
# للحصول على هذه البيانات: أنشئ مشروعاً جديداً على https://supabase.com وافتح Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. إعدادات بوت Telegram (اختياري للإشعارات والتسجيل الفوري)
# للحصول على التوكن: تواصل مع @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_USERNAME=TarqaQudratBot
