# ==============================================================================
# منصة طرقع - ملف متغيرات البيئة النموذجي
# Tarqa Platform - Environment Variables Template (.env.example)
# ==============================================================================
# انسخ هذا الملف باسم .env وضع فيه بياناتك ومفاتيحك الحقيقية
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الدومين والاستضافة و سياسات الـ CORS (Domain & Host Configuration)
# ------------------------------------------------------------------------------
# رابط الموقع / الدومين الجديد بالكامل (مع https://)
VITE_SITE_URL=https://tarqa3.net
SITE_URL=https://tarqa3.net

# المسار النسبي لواجهة الـ API البرمجية (الافتراضي: /api)
VITE_API_URL=/api

# قائمة النطاقات المسموح لها بالـ CORS والوصول مفصولة بفاصلة
ALLOWED_ORIGINS=https://tarqa3.net,https://www.tarqa3.net,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. إعدادات قاعدة بيانات سوبابيز (Supabase Database & Authentication)
# ------------------------------------------------------------------------------
# احصل على هذه البيانات من: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# للمشاريع التي تستخدم Next.js أو السيرفر (توافق خلفي)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# مفتاح السوبر أدمن السري (يُستخدم في السيرفر فقط ولا يُكشف للواجهة)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. إعدادات بوت تليجرام الرسمي (@Tarqa3bot)
# ------------------------------------------------------------------------------
# احصل على التوكن من @BotFather على تليجرام
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_BOT_USERNAME=Tarqa3bot

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=Tarqa3bot

# ------------------------------------------------------------------------------
# 4. إعدادات بوابة الدفع الإلكتروني كاشير (Kashier Payment Gateway)
# ------------------------------------------------------------------------------
# احصل على المفاتيح من: https://merchant.kashier.io
# الوضع: test للتجربة أو live للإنتاج الحقيقي
VITE_KASHIER_MODE=test
VITE_KASHIER_MERCHANT_ID=MID-TARQA-TEST
VITE_KASHIER_API_KEY=your_kashier_api_key_here
VITE_KASHIER_SECRET_KEY=your_kashier_secret_key_here

KASHIER_MODE=test
KASHIER_MERCHANT_ID=MID-TARQA-TEST
KASHIER_API_KEY=your_kashier_api_key_here
KASHIER_SECRET_KEY=your_kashier_secret_key_here

# ------------------------------------------------------------------------------
# 5. التشفير ومفتاح جلسات السيرفر (Security & Session Secret)
# ------------------------------------------------------------------------------
JWT_SECRET=tarqa_qudrat_secure_session_secret_2026
