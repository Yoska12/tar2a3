# ===================================================================
# ملف إعدادات البيئة لمنصة طرقع لاختبارات قدرات كمي
# Tarqa Platform Environment Variables
# ===================================================================

# 1. إعدادات قاعدة بيانات ومصادقة Supabase (اختياري، المنصة تدعم وضع المعاينة الفوري محلياً)
# للحصول على هذه البيانات: أنشئ مشروعاً جديداً على https://supabase.com وافتح Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. إعدادات بوت Telegram (@Tarqa3bot)
TELEGRAM_BOT_TOKEN=8848350461:AAGTM9m-RQpCmJ-MKLrUlbygXYUzEWhO-R4
TELEGRAM_BOT_USERNAME=Tarqa3bot
VITE_TELEGRAM_BOT_TOKEN=8848350461:AAGTM9m-RQpCmJ-MKLrUlbygXYUzEWhO-R4
VITE_TELEGRAM_BOT_USERNAME=Tarqa3bot

# 3. إعدادات بوابة دفع كاشير (Kashier Payment Gateway)
# احصل على هذه البيانات من: https://merchant.kashier.io
KASHIER_MODE=test
KASHIER_MERCHANT_ID=MID-XXXX-XXXX
KASHIER_API_KEY=your_kashier_api_key
KASHIER_SECRET_KEY=your_kashier_secret_key
VITE_KASHIER_MERCHANT_ID=MID-XXXX-XXXX
VITE_KASHIER_API_KEY=your_kashier_api_key
VITE_KASHIER_SECRET_KEY=your_kashier_secret_key
