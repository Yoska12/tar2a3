# ==============================================================================
# منصة طرقع - ملف إعدادات أباتشي و لايت سبيد (Apache / LiteSpeed Web Server)
# Tarqa Platform - Production .htaccess (Agent-Ready, SPA Routing, CORS, Security & 404s)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. خيارات السيرفر الأساسية ونقطة الدخول (Server Options & DirectoryIndex)
# ------------------------------------------------------------------------------
DirectoryIndex index.html index.php

<IfModule mod_dir.c>
  DirectoryIndex index.html index.php
</IfModule>
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
ServerSignature Off

# ------------------------------------------------------------------------------
# 2. ضبط أنواع الملفات (MIME Types) للمتصفحات ووكلاء الذكاء الاصطناعي
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript              .js .mjs
  AddType application/json                    .json .map
  AddType application/wasm                    .wasm
  AddType application/manifest+json           .webmanifest
  AddType image/svg+xml                       .svg .svgz
  AddType font/woff                           .woff
  AddType font/woff2                          .woff2
  AddType application/pdf                     .pdf
  AddType text/plain                          .txt
  AddType text/markdown                       .md
  AddCharset UTF-8                            .html .css .js .json .svg .xml .txt .md
</IfModule>

# ------------------------------------------------------------------------------
# 3. إعدادات مشاركة الموارد وتوجيه إشارات الذكاء الاصطناعي (CORS & Content Signals)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # السماح بالوصول عبر النطاقات مع دعم الـ Preflight OPTIONS
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH, HEAD"
  Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, Range, X-CSRF-Token, api-key, Cache-Control"
  Header always set Access-Control-Expose-Headers "Content-Length, Content-Range, Content-Disposition, Content-Type, Link, Content-Signal"
  Header always set Access-Control-Max-Age "86400"

  # إشارة Content-Signal الرسمية لوكلاء ومحركات الذكاء الاصطناعي
  Header always set Content-Signal "search=yes, ai-train=no"

  # ----------------------------------------------------------------------------
  # 4. ترويسات الحماية والأمان المتقدمة (Security Headers)
  # ----------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self 'https://checkout.kashier.io' 'https://payments.kashier.io')"
</IfModule>

# ------------------------------------------------------------------------------
# 5. ضغط الملفات لتسريع التحميل (Gzip / Deflate Compression)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/markdown
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 6. إدارة التخزين المؤقت وترويسات الموارد الذكية (Caching & Link Headers)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # ملف index.html لا يُخزن أبداً لضمان استلام الزائر لأحدث نسخة فور النشر
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/markdown "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 hour"

  # ملفات الـ Assets المخرجة من Vite
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# توجيه الخطأ 404 الفعلي لصفحة الخطأ 404
ErrorDocument 404 /404.php

# ترويسات صفحة index.html وترويسات Link للموارد الذكية (RFC 8288 Discovery)
<Files "index.html">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set Link "</llms.txt>; rel=\"alternate\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\""
  </IfModule>
</Files>

# ترويسة Link عند طلب الجذر / مباشرة
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(index\.html)?$" IS_HOMEPAGE=1
  Header set Link "</llms.txt>; rel=\"alternate\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\"" env=IS_HOMEPAGE
</IfModule>

# ترويسات ملف index.md عند تقديمه كـ Markdown
<Files "index.md">
  <IfModule mod_headers.c>
    Header set Content-Type "text/markdown; charset=utf-8"
    Header set Vary "Accept"
    Header set Access-Control-Allow-Origin "*"
  </IfModule>
</Files>

# ترويسات ملف llms.txt
<Files "llms.txt">
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </IfModule>
</Files>

# ترويسات ملف server-card.json
<Files "server-card.json">
  <IfModule mod_headers.c>
    Header set Content-Type "application/json; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </IfModule>
</Files>

# ------------------------------------------------------------------------------
# 7. حماية الملفات الحساسة وبيانات الاعتماد (Protect Sensitive Files)
# ------------------------------------------------------------------------------
<FilesMatch "(^\.env|^\.git|package\.json|package-lock\.json|tsconfig\.json|vite\.config\.ts|\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 8. إعادة توجيه الروابط وتوجيه وكلاء الذكاء الاصطناعي (SPA Routing)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # أ. معالجة طلبات الـ Preflight OPTIONS برمز 204 فوري
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=204,L]

  # ب. تحويل الاتصال تلقائياً إلى بروتوكول HTTPS الآمن
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ج. خدمة تمثيل Markdown لوكلاء الذكاء الاصطناعي عند إرسال Accept: text/markdown
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{REQUEST_URI} ^/?(index(\.html)?)?$
  RewriteRule ^.*$ index.md [T=text/markdown,L]

  # د. استثناء الملفات والمجلدات الحقيقية الموجودة بالفعل على السيرفر
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # هـ. استثناء مسارات الـ API والمحاكيات ومجلد التخزين المباشر ومجلد .well-known
  RewriteRule ^api/shared-questions/?$ api/shared-questions.php [L,QSA]
  RewriteRule ^api/points/?$ api/points.php [L,QSA]
  RewriteRule ^api/subscriptions/?$ api/subscriptions.php [L,QSA]
  RewriteRule ^api/hostinger_api/?$ api/hostinger_api.php [L,QSA]
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]
  RewriteRule ^simulation/ - [L]
  RewriteRule ^exam/ - [L]
  RewriteRule ^tiger/ - [L]
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^llms\.txt$ - [L]
  RewriteRule ^llms-full\.txt$ - [L]
  RewriteRule ^index\.md$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]

  # و. توجيه المسارات المعروفة للتطبيق التفاعلي (SPA Routes) فقط إلى index.html
  RewriteRule ^(courses|quiz|simulator|dashboard|leaderboard|admin|classroom|login|signin|signup|register|categories|roadmap|about|contact|terms|privacy)/?$ index.html [L]
  RewriteRule ^$ index.html [L]

  # ز. إرجاع رمز 404 فعلي ومباشر لأي رابط غير موجود (Agent-Ready Real 404)
  RewriteRule ^ 404.php [L]
</IfModule>

# ------------------------------------------------------------------------------
# 9. إعدادات رفع الملفات والذاكرة لسيرفر هوستينجر (Hostinger Upload & Memory Limits)
# ------------------------------------------------------------------------------
<IfModule mod_php.c>
  php_value upload_max_filesize 512M
  php_value post_max_size 512M
  php_value memory_limit 512M
  php_value max_execution_time 600
  php_value max_input_time 600
</IfModule>

<IfModule mod_php7.c>
  php_value upload_max_filesize 512M
  php_value post_max_size 512M
  php_value memory_limit 512M
  php_value max_execution_time 600
  php_value max_input_time 600
</IfModule>

<IfModule mod_php8.c>
  php_value upload_max_filesize 512M
  php_value post_max_size 512M
  php_value memory_limit 512M
  php_value max_execution_time 600
  php_value max_input_time 600
</IfModule>
